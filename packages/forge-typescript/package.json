{
  "name": "@warpgogol/forge-typescript",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Forge first-party TypeScript stack plugin (scaffold \u2014 v9 implementation in git history, v10 rewrite at program WP-5).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/werkstatt-typescript.git"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./paths": {
      "types": "./src/paths/typescript-paths.ts",
      "default": "./src/paths/typescript-paths.ts"
    },
    "./invariants": {
      "types": "./src/invariants/typescript-invariants.ts",
      "default": "./src/invariants/typescript-invariants.ts"
    },
    "./checks/module": {
      "types": "./src/checks/module.ts",
      "default": "./src/checks/module.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "echo lint-pending",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo tests-pending"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@warpgogol/forge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.0"
  }
}
